[Unit]
Description=Cold-standby boot-mode controller
Documentation=https://github.com/HaraldR42/pve-coldstandby
# pve-guests.service is masked permanently on this node -- guest starts
# only happen via this controller's own start logic (Emergency mode).
After=network-online.target pve-cluster.service
Wants=network-online.target

[Service]
# Not oneshot: the boot work runs once, then -- when MQTT is configured --
# the process stays resident holding the `online` presence connection open
# until stopped. Without MQTT it exits after the boot work; RemainAfterExit
# keeps the unit shown as active in that case.
Type=simple
ExecStart=/usr/bin/python3 -m coldstandby.main
RemainAfterExit=yes
Restart=no
# On stop it announces `online=false` and disconnects cleanly; give it room.
TimeoutStopSec=30
# The `coldstandby` package must be importable. This assumes the repo is
# checked out at /opt/pve-coldstandby (so /opt/pve-coldstandby/coldstandby/
# exists). If you instead `pip install` it (into the system or a venv),
# point ExecStart at that interpreter / the `coldstandby` entry point and
# delete this line.
WorkingDirectory=/opt/pve-coldstandby
# All output goes to the journal; read a run with `journalctl -u coldstandby`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coldstandby

[Install]
WantedBy=multi-user.target
